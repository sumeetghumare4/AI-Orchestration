{
  "version": 2,
  "builds": [
    {
      "src": "apps/frontend/package.json",
      "use": "vite",
      "config": {
        "installCommand": "pnpm install --no-frozen-lockfile",
        "buildCommand": "pnpm build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/frontend/dist/$1"
    }
  ]
}