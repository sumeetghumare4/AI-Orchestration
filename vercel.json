{
  "version": 2,
  "builds": [
    {
      "src": "apps/frontend/package.json",
      "use": "vite",
      "config": {
        "installCommand": "pnpm install --filter @ai-platform/frontend --ignore-workspace",
        "buildCommand": "pnpm --filter @ai-platform/frontend build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/frontend/dist/$1"
    }
  ]
}