{
  "name": "@ai-platform/prompts",
  "version": "0.1.0",
  "description": "Prompt management system with versioning, templates, and A/B testing",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
