{
  "name": "ai-training-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm install && pnpm -r build",
    "dev:backend": "pnpm --filter @ai-platform/backend dev",
    "dev:frontend": "pnpm --filter @ai-platform/frontend dev",
    "dev:cli": "pnpm --filter @ai-platform/cli dev",
    "test": "jest --config jest.config.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "description": "AI Training and Prompt Engineering Platform",
  "license": "MIT"
}